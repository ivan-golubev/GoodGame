<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(SolutionDir)lib\glm;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!--
        GLM_FORCE_DEPTH_ZERO_TO_ONE: make glm's projection matrices (perspectiveFovLH, etc.) map the
        near plane to z = 0 and the far plane to z = 1, the clip-space depth range of Vulkan and D3D12.
        glm defaults to OpenGL's -1..1; both APIs clip z < 0, so without this the part of the view
        frustum between the near plane and roughly twice the near distance was clipped away, and half
        of the depth buffer's range was wasted.
        Must be defined identically in every project that includes glm: glm types cross module
        boundaries, so all projects import this props file.
      -->
      <PreprocessorDefinitions>GLM_FORCE_DEPTH_ZERO_TO_ONE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
