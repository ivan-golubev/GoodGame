<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <AssimpLibDir>$(SolutionDir)lib\assimp-out\Debug</AssimpLibDir>
    <ZLibDir>$(SolutionDir)lib\assimp\contrib\zlib\Debug</ZLibDir>
    <ZLib>$(ZLibDir)\zlibstaticd</ZLib>
    <AssimLib>assimp-vc145-mtd</AssimLib>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release' Or '$(Configuration)'=='Final'">
    <AssimpLibDir>$(SolutionDir)lib\assimp-out\Release</AssimpLibDir>
    <ZLibDir>$(SolutionDir)lib\assimp\contrib\zlib\Release</ZLibDir>
    <ZLib>$(ZLibDir)\zlibstatic</ZLib>
    <AssimLib>assimp-vc145-mt</AssimLib>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(SolutionDir)lib\assimp\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(AssimpLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(AssimLib).lib;$(ZLib).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
